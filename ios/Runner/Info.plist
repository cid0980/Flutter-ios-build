<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>French Mobiles</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>french_mobiles</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iOS Hardware & Privacy Usage Descriptions for Auto Checkup & App Features -->
	<key>NSCameraUsageDescription</key>
	<string>French Mobiles uses the camera and rear flash to verify camera and flashlight hardware during device checkup and to take profile photos.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>French Mobiles uses the microphone during device checkup to verify audio capture hardware.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>French Mobiles uses Face ID / Touch ID during device checkup to verify that biometric authentication hardware is functioning properly.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>French Mobiles needs access to your photo library so you can select and upload a profile photo or device images.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>French Mobiles needs permission to save photos to your library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>French Mobiles uses your location to test GPS hardware, verify Wi-Fi connectivity, and set your doorstep pickup address on the map.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>French Mobiles uses your location to test GPS hardware, verify Wi-Fi connectivity, and set your doorstep pickup address on the map.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>French Mobiles uses Bluetooth during device checkup to verify that the Bluetooth radio can scan for nearby devices.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>French Mobiles uses Bluetooth during device checkup to verify that the Bluetooth radio is working.</string>
	<key>NSMotionUsageDescription</key>
	<string>French Mobiles uses the gyroscope and accelerometer during device checkup to verify motion sensors.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>French Mobiles checks local network interfaces during device checkup to verify Wi-Fi and cellular connectivity.</string>
	<!-- External URL schemes used by url_launcher -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>mailto</string>
		<string>sms</string>
		<string>whatsapp</string>
		<string>https</string>
		<string>http</string>
	</array>
	<!-- Google Sign-In default configuration -->
	<key>GIDClientID</key>
	<string>1086357315686-gd3cjbuqqll9umc7peffkd04laiq6hmt.apps.googleusercontent.com</string>
	<key>GIDServerClientID</key>
	<string>1086357315686-gd3cjbuqqll9umc7peffkd04laiq6hmt.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1086357315686-gd3cjbuqqll9umc7peffkd04laiq6hmt</string>
				<string>com.example.frenchMobiles</string>
			</array>
		</dict>
	</array>
	<!-- Disable Firebase AppDelegate/SceneDelegate swizzling (prevents launch crash without APNs entitlements) -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
</dict>
</plist>
